{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "gotauth",
  "homepage": "https://gotauth.ablacky.com",
  "items": [
    {
      "name": "gotauth-client",
      "type": "registry:lib",
      "title": "GotAuth client",
      "description": "Typed fetch client for GotAuth's HTTP API, with cookies.",
      "files": [
        {
          "path": "src/lib/gotauth-client.ts",
          "type": "registry:lib",
          "target": "lib/gotauth-client.ts"
        }
      ]
    },
    {
      "name": "webauthn",
      "type": "registry:lib",
      "title": "WebAuthn helpers",
      "description": "base64url and ArrayBuffer conversion for passkey options and responses.",
      "files": [
        {
          "path": "src/lib/webauthn.ts",
          "type": "registry:lib",
          "target": "lib/webauthn.ts"
        }
      ]
    },
    {
      "name": "gotauth-provider",
      "type": "registry:component",
      "title": "GotAuth provider",
      "description": "Supplies the GotAuth client to the components.",
      "registryDependencies": [
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/gotauth-provider.tsx",
          "type": "registry:component",
          "target": "components/gotauth/gotauth-provider.tsx"
        }
      ]
    },
    {
      "name": "use-session",
      "type": "registry:hook",
      "title": "useSession",
      "description": "The current session, shared and refetched after sign-in and sign-out.",
      "registryDependencies": [
        "@gotauth/gotauth-provider",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/hooks/use-session.ts",
          "type": "registry:hook",
          "target": "hooks/use-session.ts"
        }
      ]
    },
    {
      "name": "form-message",
      "type": "registry:component",
      "title": "Form message",
      "description": "Accessible error and status messages for GotAuth forms.",
      "registryDependencies": [
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/form-message.tsx",
          "type": "registry:component",
          "target": "components/gotauth/form-message.tsx"
        }
      ]
    },
    {
      "name": "social-buttons",
      "type": "registry:component",
      "title": "Social buttons",
      "description": "Sign in with GitHub, Google and other providers.",
      "registryDependencies": [
        "button",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message"
      ],
      "files": [
        {
          "path": "src/components/gotauth/social-buttons.tsx",
          "type": "registry:component",
          "target": "components/gotauth/social-buttons.tsx"
        }
      ]
    },
    {
      "name": "sign-in-form",
      "type": "registry:component",
      "title": "Sign-in form",
      "description": "Email and password sign-in with social buttons and the two-factor step.",
      "registryDependencies": [
        "button",
        "card",
        "input",
        "label",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/social-buttons",
        "@gotauth/two-factor-challenge",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/sign-in-form.tsx",
          "type": "registry:component",
          "target": "components/gotauth/sign-in-form.tsx"
        }
      ]
    },
    {
      "name": "sign-up-form",
      "type": "registry:component",
      "title": "Sign-up form",
      "description": "Email and password sign-up with social buttons.",
      "registryDependencies": [
        "button",
        "card",
        "input",
        "label",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/social-buttons",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/sign-up-form.tsx",
          "type": "registry:component",
          "target": "components/gotauth/sign-up-form.tsx"
        }
      ]
    },
    {
      "name": "user-button",
      "type": "registry:component",
      "title": "User button",
      "description": "The signed-in user's avatar and a sign-out menu.",
      "registryDependencies": [
        "avatar",
        "button",
        "dropdown-menu",
        "@gotauth/gotauth-provider",
        "@gotauth/use-session"
      ],
      "files": [
        {
          "path": "src/components/gotauth/user-button.tsx",
          "type": "registry:component",
          "target": "components/gotauth/user-button.tsx"
        }
      ]
    },
    {
      "name": "session-list",
      "type": "registry:component",
      "title": "Session list",
      "description": "Devices signed in to the account, with sign-out buttons.",
      "registryDependencies": [
        "button",
        "table",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/session-list.tsx",
          "type": "registry:component",
          "target": "components/gotauth/session-list.tsx"
        }
      ]
    },
    {
      "name": "api-key-manager",
      "type": "registry:component",
      "title": "API key manager",
      "description": "Create, list and delete API keys; new keys are shown once.",
      "registryDependencies": [
        "alert",
        "button",
        "dialog",
        "input",
        "label",
        "table",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/api-key-manager.tsx",
          "type": "registry:component",
          "target": "components/gotauth/api-key-manager.tsx"
        }
      ]
    },
    {
      "name": "qr-code",
      "type": "registry:component",
      "title": "QR code",
      "description": "A QR code drawn locally as SVG, for authenticator setup.",
      "dependencies": [
        "uqr@0.1.3"
      ],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/components/gotauth/qr-code.tsx",
          "type": "registry:component",
          "target": "components/gotauth/qr-code.tsx"
        }
      ]
    },
    {
      "name": "two-factor-setup",
      "type": "registry:component",
      "title": "Two-factor setup",
      "description": "Turn on an authenticator app (QR code, backup codes shown once) or turn it off.",
      "registryDependencies": [
        "alert",
        "button",
        "card",
        "input",
        "label",
        "@gotauth/qr-code",
        "@gotauth/use-session",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/two-factor-setup.tsx",
          "type": "registry:component",
          "target": "components/gotauth/two-factor-setup.tsx"
        }
      ]
    },
    {
      "name": "two-factor-challenge",
      "type": "registry:component",
      "title": "Two-factor challenge",
      "description": "The second sign-in step: authenticator code, backup code or emailed code.",
      "registryDependencies": [
        "button",
        "card",
        "input",
        "label",
        "@gotauth/two-factor-setup",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/two-factor-challenge.tsx",
          "type": "registry:component",
          "target": "components/gotauth/two-factor-challenge.tsx"
        }
      ]
    },
    {
      "name": "passkey-button",
      "type": "registry:component",
      "title": "Passkey button",
      "description": "Sign in with a passkey, or add one to the account.",
      "registryDependencies": [
        "button",
        "@gotauth/webauthn",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/passkey-button.tsx",
          "type": "registry:component",
          "target": "components/gotauth/passkey-button.tsx"
        }
      ]
    },
    {
      "name": "org-switcher",
      "type": "registry:component",
      "title": "Organization switcher",
      "description": "Choose the organization the session acts in.",
      "registryDependencies": [
        "button",
        "dropdown-menu",
        "@gotauth/use-session",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/org-switcher.tsx",
          "type": "registry:component",
          "target": "components/gotauth/org-switcher.tsx"
        }
      ]
    },
    {
      "name": "consent-screen",
      "type": "registry:component",
      "title": "OAuth consent screen",
      "description": "Allow or deny an app's access, with its redirect host and scopes; a native form post.",
      "registryDependencies": [
        "alert",
        "button",
        "card",
        "@gotauth/gotauth-provider",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/consent-screen.tsx",
          "type": "registry:component",
          "target": "components/gotauth/consent-screen.tsx"
        }
      ]
    },
    {
      "name": "connected-apps",
      "type": "registry:component",
      "title": "Connected apps",
      "description": "Apps with OAuth access to the account, each with a revoke button.",
      "registryDependencies": [
        "button",
        "table",
        "@gotauth/gotauth-provider",
        "@gotauth/form-message",
        "@gotauth/gotauth-client"
      ],
      "files": [
        {
          "path": "src/components/gotauth/connected-apps.tsx",
          "type": "registry:component",
          "target": "components/gotauth/connected-apps.tsx"
        }
      ]
    }
  ]
}

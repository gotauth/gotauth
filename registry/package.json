{
  "name": "@gotauth/registry",
  "version": "0.0.0",
  "private": true,
  "description": "GotAuth UI components (shadcn registry) and typed fetch client",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "shadcn build",

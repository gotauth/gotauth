# Copy to .env for local builds. For the automatic cPanel deploy, set these as
# repository variables instead (README.md, "Deploy to cPanel"). All are optional.

# Form backend URL. Unset: the page shows "Waitlist opens soon" and a GitHub link.
# Formspree:  https://formspree.io/f/<form-id>
# Web3Forms:  https://api.web3forms.com/submit
PUBLIC_WAITLIST_ENDPOINT=

# Honeypot field name the backend checks. Formspree: _gotcha (default). Web3Forms: botcheck.
PUBLIC_WAITLIST_HONEYPOT=

# Extra hidden fields, URL-encoded. Web3Forms needs its access key here, e.g.
# access_key=<key>&subject=GotAuth%20waitlist&redirect=https%3A%2F%2Fgotauth.ablacky.com%2Fthanks%2F
PUBLIC_WAITLIST_FIELDS=

# Shown in the privacy note, e.g. Formspree or Web3Forms.
PUBLIC_WAITLIST_PROVIDER=

# Repository link. Default: https://github.com/gotauth/gotauth
PUBLIC_GITHUB_URL=

# Contact address for the footer and the privacy note. Default: a link to GitHub issues.
PUBLIC_CONTACT_EMAIL=

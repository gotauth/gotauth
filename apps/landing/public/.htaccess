# Apache settings for the static site on cPanel (copied into dist/ by the build).
# The Content-Security-Policy is in each page's <meta> tag (Astro security.csp);
# frame-ancestors only works as a header, so framing is blocked here instead.

Options -Indexes
ErrorDocument 404 /404.html

# HTTPS only. Behind a proxy that ends TLS (for example Cloudflare), Apache sees
# plain HTTP; then rely on the proxy's "Always use HTTPS" setting and remove this.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  # Hashed build assets never change: cache them for a year. Pages revalidate.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Else>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml
</IfModule>

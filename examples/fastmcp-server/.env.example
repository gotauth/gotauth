# Copy to .env. Never commit .env.

# Required. Make one with: uv run gotauth secret
GOTAUTH_SECRET=

# The public origin. Keep the default for MCP Inspector on this machine; set your
# tunnel's https URL when Claude or another hosted client connects.
# BASE_URL=https://example.trycloudflare.com

# Optional: another database (default: SQLite in app.db).
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app

# Copy to .env. Never commit .env.

# Required. Make one with: docker compose run --rm backend gotauth secret
GOTAUTH_SECRET=

# Optional: "Continue with GitHub". Create an OAuth app at
# https://github.com/settings/developers with the callback URL
# http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Postgres instead of SQLite (with: docker compose --profile postgres up).
# DATABASE_URL=postgresql+asyncpg://gotauth:gotauth@postgres:5432/gotauth

{
  "alias": "gotauth",
  "description": "GotAuth OAuth 2.1 server and OIDC provider (code flow, PKCE S256)",
  "server": {
    "discoveryUrl": "https://op.example.test/api/auth/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "<printed by the app at startup>",
    "client_secret": "<printed by the app at startup>",
    "scope": "openid profile email"
  },
  "client2": {
    "client_id": "<printed by the app at startup>",
    "client_secret": "<printed by the app at startup>"
  },
  "test_plan": "oidcc-basic-certification-test-plan",
  "variant": {
    "server_metadata": "discovery",
    "client_registration": "static_client",
    "client_auth_type": "client_secret_basic",
    "response_type": "code"
  },
  "browser": [
    {
      "match": "https://op.example.test/api/auth/oauth2/authorize*",
      "tasks": [
        {
          "task": "Sign in",
          "optional": true,
          "match": "https://op.example.test/sign-in*",
          "commands": [
            ["text", "id", "email", "conformance@example.com"],
            ["text", "id", "password", "conformance-password"],
            ["click", "id", "sign-in"]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://op.example.test/api/auth/oauth2/authorize*",
          "commands": [
            ["click", "id", "allow"]
          ]
        },
        {
          "task": "Verify complete",
          "match": "*/test/a/gotauth/callback*",
          "commands": [
            ["wait", "id", "submission_complete", 10]
          ]
        }
      ]
    }
  ]
}
